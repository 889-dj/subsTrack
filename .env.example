# Use the local mock during UI development. Set to false for the real backend.
EXPO_PUBLIC_USE_MOCK_API=true
# Include the API version prefix, for example https://api.substrack.app/v1.
EXPO_PUBLIC_API_URL=
# Clerk publishable key is safe to include in the app bundle. Never add the
# Clerk secret key here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# RevenueCat public SDK keys (app.revenuecat.com → Project → API keys).
# These are the *public* platform keys, not the secret key — never put the
# secret key in the app bundle.
# Copy this file to .env and fill in the values, then restart the bundler.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
